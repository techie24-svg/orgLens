# OrgLens backend configuration.
# Copy to `.env` for local `vercel dev`, and set the same vars in your Vercel
# project settings for production. Never commit real secrets.

# From your Salesforce Connected App (Setup > App Manager > New Connected App):
#   - Enable OAuth Settings
#   - Callback URL: http://localhost:3000/api/oauth/callback  (local)
#                   https://<your-app>.vercel.app/api/oauth/callback  (prod)
#   - Scopes: Manage user data via APIs (api), Perform requests any time (refresh_token, web)
#   - Require PKCE: enabled (recommended)
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret

# Random 32+ char string used to encrypt the session cookie.
# Generate with: openssl rand -base64 48
SESSION_SECRET=change_me_to_a_long_random_string

# Optional: override the OAuth callback URL. If unset, it is derived from the
# incoming request host (recommended for Vercel preview + production domains).
# OAUTH_REDIRECT_URI=https://your-app.vercel.app/api/oauth/callback
